#include<stdio.h>
#include<stdlib.h>
int main() {
     int *arr,i,n,sum=0;
         printf("enter number of element:");
                scanf("%d",&n);
           arr=(int*) calloc(n,sizeof(int));
                 if(arr == NULL) {
        printf("memory allocation failed");
return 0;
}
for(i=0; i<n; i++) {
       printf("enter %d element:\n,i+1);
            scanf("%d",&arr[i]);
                     sum=sum+arr[i];
}
       printf("sum of element=%d\n", sum);
           free(arr);
return 0;
}
